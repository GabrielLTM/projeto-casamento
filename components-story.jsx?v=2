  return (
    <div className={`tl-item tl-${side}`}>
      <div className="tl-dot" />
      <div className="tl-card">
        <div className="polaroid" style={{ "--rot": `${item.rotate}deg` }}>
          <div className="polaroid-photo">
            <PolaroidPhoto item={item} />
          </div>
          <div className="polaroid-caption">
            <span>{item.date}</span>
          </div>
        </div>
        <div className="tl-text">
          <span className="tl-num">0{index + 1}</span>
          <h3>{item.title}</h3>
          <p style={{ width: "39px", padding: "0px", textAlign: "left", fontWeight: "400", margin: "0px 0px 0px 120px" }}>{item.text}</p>
        </div>
      </div>
    </div>);

}

