{
  "name": "casamento-gabriel-kamilly",
  "version": "1.0.0",
  "private": true,
  "description": "Site de casamento Gabriel & Kamilly com lista de presentes e reservas",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "node --watch server/src/index.js",
    "start": "node server/src/index.js",
    "postinstall": "prisma generate",
    "db:push": "prisma db push"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  },
  "allowScripts": {
    "prisma@5.22.0": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true
  }
}
